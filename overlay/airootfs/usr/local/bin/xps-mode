#!/bin/bash
# xps-mode: switch between coding and free mode (school is on the tablet).
#   xps-mode coding|free            switch now and open that mode's apps
#   xps-mode auto [--launch]        pick the mode from the clock (a timer runs this every 15 min)
#   xps-mode pick                   only print the mode the clock says (for testing)

conf="${XDG_CONFIG_HOME:-$HOME/.config}/xps-modes/schedule.conf"
state="${XDG_STATE_HOME:-$HOME/.local/state}/xps-mode"

CODE_START=13:00
CODE_END=18:00
WEEKEND=coding
WEEKEND_START=08:00
[ -f "$conf" ] && . "$conf"

mins() { local h=${1%%:*} m=${1##*:}; echo $((10#$h * 60 + 10#$m)); }

pick() {
    local now dow
    now=$(mins "$(date -d "${XPS_NOW:-now}" +%H:%M)")
    dow=$(date -d "${XPS_NOW:-now}" +%u)
    in_range() { [ "$now" -ge "$(mins "$1")" ] && [ "$now" -lt "$(mins "$2")" ]; }
    if [ "$dow" -ge 6 ]; then
        if [ "$WEEKEND" = coding ] && in_range "$WEEKEND_START" "$CODE_END"; then echo coding; else echo free; fi
    elif in_range "$CODE_START" "$CODE_END"; then echo coding
    else echo free
    fi
}

say() { command -v notify-send >/dev/null && notify-send -a "XPS Modes" "$1" "$2"; return 0; }
dnd() { command -v xfconf-query >/dev/null && xfconf-query -c xfce4-notifyd -p /do-not-disturb -n -t bool -s "$1"; return 0; }

# Who gets CPU first when everything is busy: $1 = browser weight, $2 = build weight
weights() {
    command -v systemctl >/dev/null || return 0
    systemctl --user set-property --runtime xps-browser.slice CPUWeight="$1" 2>/dev/null
    systemctl --user set-property --runtime xps-build.slice CPUWeight="$2" 2>/dev/null
    return 0
}

start_code() {
    pgrep -x code >/dev/null && return 0
    systemd-run --user --scope --slice=xps-build.slice -q code >/dev/null 2>&1 &
}

apply() {
    local mode=$1 launch=$2 prev=""
    [ -f "$state" ] && prev=$(cat "$state")
    mkdir -p "$(dirname "$state")"
    echo "$mode" > "$state"
    case "$mode" in
        coding)
            [ "$prev" != coding ] && say "Coding time" "Compiles get priority. Notifications are paused."
            weights 100 800; dnd true
            [ "$launch" = 1 ] && start_code ;;
        free)
            dnd false; weights 100 100
            [ "$prev" != free ] && say "Free time" "Everything is back to normal." ;;
    esac
    wait
}

case "${1:-auto}" in
    pick) pick ;;
    auto)
        mode=$(pick)
        launch=0; [ "$2" = --launch ] && launch=1
        prev=""; [ -f "$state" ] && prev=$(cat "$state")
        [ "$mode" = "$prev" ] && [ "$launch" = 0 ] && exit 0
        apply "$mode" "$launch" ;;
    coding|free) apply "$1" 1 ;;
    *) echo "usage: xps-mode coding|free|auto|pick"; exit 1 ;;
esac
