#!/usr/bin/python3
"""Small offline AI assistant: a chat window on top of a local model (ollama). Nothing leaves the laptop."""
import json
import os
import subprocess
import sys
import threading
import time
import urllib.request

try:
    import tkinter as tk
    from tkinter import scrolledtext
except ImportError:
    subprocess.run(["notify-send", "AI assistant", "The tk package is missing from this image."])
    sys.exit(1)

MODEL = os.environ.get("XPS_MODEL", "qwen2.5:1.5b")
HOST = "http://127.0.0.1:11434"
MODEL_DIR = "/usr/share/xps-models/ollama"
SYSTEM = ("You are a short, practical assistant for a student who writes code for Arduino and ESP32 boards, "
          "uses Linux, and runs a Raspberry Pi server. Answer briefly and clearly. If unsure, say so.")


def server_up():
    try:
        urllib.request.urlopen(HOST, timeout=1).close()
        return True
    except Exception:
        return False


def start_server():
    if server_up():
        return True
    env = dict(os.environ, OLLAMA_KEEP_ALIVE="2m", OLLAMA_HOST="127.0.0.1:11434", OLLAMA_NUM_PARALLEL="1")
    if os.path.isdir(MODEL_DIR):
        env["OLLAMA_MODELS"] = MODEL_DIR
    try:
        subprocess.Popen(["ollama", "serve"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except FileNotFoundError:
        return False
    for _ in range(40):
        if server_up():
            return True
        time.sleep(0.5)
    return False


def has_model():
    try:
        with urllib.request.urlopen(HOST + "/api/tags", timeout=3) as response:
            data = json.load(response)
        return any(m.get("name", "").startswith(MODEL.split(":")[0]) for m in data.get("models", []))
    except Exception:
        return False


def chat(messages):
    body = json.dumps({"model": MODEL, "messages": messages, "stream": False,
                       "options": {"num_ctx": 4096, "temperature": 0.4}}).encode()
    req = urllib.request.Request(HOST + "/api/chat", body, {"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=300) as response:
        return json.load(response)["message"]["content"].strip()


class App:
    def __init__(self, root):
        self.root = root
        root.title("AI assistant (offline)")
        root.geometry("720x520")
        self.log = scrolledtext.ScrolledText(root, wrap="word", state="disabled", font=("Sans", 11))
        self.log.pack(fill="both", expand=True, padx=8, pady=(8, 4))
        row = tk.Frame(root)
        row.pack(fill="x", padx=8, pady=(0, 8))
        self.entry = tk.Entry(row, font=("Sans", 11))
        self.entry.pack(side="left", fill="x", expand=True)
        self.entry.bind("<Return>", lambda e: self.send())
        self.btn = tk.Button(row, text="Send", command=self.send)
        self.btn.pack(side="left", padx=(6, 0))
        self.messages = [{"role": "system", "content": SYSTEM}]
        self.busy = True
        self.say("Starting the assistant...\n")
        threading.Thread(target=self.boot, daemon=True).start()

    def say(self, text):
        self.log.configure(state="normal")
        self.log.insert("end", text)
        self.log.configure(state="disabled")
        self.log.see("end")

    def boot(self):
        if not start_server():
            self.root.after(0, lambda: self.say("The assistant engine could not start.\n"))
            return
        if not has_model():
            self.root.after(0, lambda: self.say(
                f"The model '{MODEL}' is not on this system yet. Connect to the internet, then run: ollama pull {MODEL}\n"))
            return
        self.busy = False
        self.root.after(0, lambda: (self.say("Ready. Ask me anything.\n\n"), self.entry.focus_set()))

    def send(self):
        text = self.entry.get().strip()
        if not text or self.busy:
            return
        self.entry.delete(0, "end")
        self.busy = True
        self.say(f"You: {text}\n")
        self.messages.append({"role": "user", "content": text})
        # Keep memory use bounded: system prompt + last 12 messages.
        self.messages = self.messages[:1] + self.messages[1:][-12:]
        threading.Thread(target=self.ask, daemon=True).start()

    def ask(self):
        try:
            answer = chat(self.messages)
            self.messages.append({"role": "assistant", "content": answer})
            self.root.after(0, lambda answer=answer: self.say(f"Assistant: {answer}\n\n"))
        except Exception as exc:
            # Exception variables are cleared after an except block; bind the value now for the UI callback.
            message = str(exc)
            self.root.after(0, lambda message=message: self.say(f"(Something went wrong: {message})\n\n"))
        finally:
            self.busy = False


if __name__ == "__main__":
    root = tk.Tk()
    App(root)
    root.mainloop()
