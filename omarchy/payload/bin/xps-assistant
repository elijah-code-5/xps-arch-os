#!/usr/bin/python3
"""Private coding assistant built locally from Qwen2.5-Coder through Ollama."""
import json
import os
import subprocess
import sys
import tempfile
import threading
import time
import urllib.request

try:
    import tkinter as tk
    from tkinter import scrolledtext, ttk
except ImportError:
    subprocess.run(["notify-send", "XPS Code Assistant", "The tk package is missing from this image."])
    sys.exit(1)

# This is a local customization of an existing open model, not a foundation model trained from scratch.
BASE_MODEL = os.environ.get("XPS_BASE_MODEL", "qwen2.5-coder:1.5b")
MODEL = os.environ.get("XPS_MODEL", "xps-coder")
HOST = "http://127.0.0.1:11434"
MODEL_DIR = "/usr/share/xps-models/ollama"
MODES = {
    "Arduino / ESP32": (
        "Focus on Arduino and ESP32 firmware, C/C++, GPIO, sensors, serial, PlatformIO/arduino-cli, "
        "and hardware debugging. Ask for the exact board and compiler/error when needed. Be careful about "
        "voltage, current, pin limits, and destructive flash/erase operations."
    ),
    "Linux sysadmin": (
        "Focus on Linux, Arch/Omarchy, shell scripting, packages, systemd, permissions, networking, and "
        "troubleshooting. Prefer reversible diagnostic commands first; clearly warn before destructive or "
        "privileged operations. Never suggest piping an unverified remote script into a root shell."
    ),
    "Raspberry Pi": (
        "Focus on Raspberry Pi projects, Raspberry Pi OS/Linux, GPIO, Python, SSH, networking, services, "
        "and connecting Pi projects to microcontrollers. Ask which Pi model and OS if it affects the answer."
    ),
    "Code review": (
        "Review code for correctness, bugs, security, reliability, and maintainability. Lead with concrete "
        "findings ordered by severity and cite relevant functions/lines when available. Distinguish confirmed "
        "issues from questions or suggestions; do not invent findings."
    ),
    "Build / debug": (
        "Focus on compiler errors, build systems, test failures, logs, and reproducible debugging. Identify "
        "the likely root cause, request missing command/toolchain details, and give the smallest safe fix before "
        "suggesting broad changes."
    ),
}
BASE_SYSTEM = (
    "You are XPS Code Assistant, a local coding and technical-work assistant for Arduino/ESP32, C/C++, Python, "
    "Linux/Arch/Omarchy shell scripts, Raspberry Pi, code review, and build/debug work. Stay within the selected "
    "technical mode. If the user asks for an unrelated topic, briefly say you are a coding assistant and ask for a "
    "programming or technical question. Ask for missing hardware/tool details instead of guessing. Provide practical "
    "examples and explain risks before destructive commands. Never claim code was tested unless it actually was."
)


def system_prompt(mode):
    return BASE_SYSTEM + "\n\nSelected mode: " + mode + ". " + MODES[mode]


def server_up():
    try:
        with urllib.request.urlopen(HOST, timeout=1):
            return True
    except Exception:
        return False


def start_server():
    if server_up():
        return True
    env = dict(os.environ, OLLAMA_KEEP_ALIVE="2m", OLLAMA_HOST="127.0.0.1:11434", OLLAMA_NUM_PARALLEL="1")
    if os.path.isdir(MODEL_DIR):
        env["OLLAMA_MODELS"] = MODEL_DIR
    try:
        subprocess.Popen(["ollama", "serve"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except FileNotFoundError:
        return False
    for _ in range(60):
        if server_up():
            return True
        time.sleep(0.5)
    return False


def installed_models():
    with urllib.request.urlopen(HOST + "/api/tags", timeout=5) as response:
        data = json.load(response)
    return {entry.get("name", "") for entry in data.get("models", [])}


def model_exists(name, names):
    return name in names or name + ":latest" in names


def ensure_custom_model(report):
    """Pull a small coding base once, then create the user's local XPS coding model with Ollama."""
    try:
        names = installed_models()
        if model_exists(MODEL, names):
            return True
        if not model_exists(BASE_MODEL, names):
            report(f"Downloading local coding base {BASE_MODEL} (one-time, around 1 GB)...")
            result = subprocess.run(["ollama", "pull", BASE_MODEL], text=True, capture_output=True)
            if result.returncode:
                report("Model download failed. Check internet and run: ollama pull " + BASE_MODEL)
                return False
        report("Creating your local XPS coding model...")
        model_file = (
            f"FROM {BASE_MODEL}\n"
            'SYSTEM """You are XPS Code Assistant, a coding-focused assistant for Arduino/ESP32, C/C++, Python, '
            "Linux/Arch/Omarchy shell scripts, Raspberry Pi, code review, and debugging. Give safe, concise, "
            'practical coding help. Ask when important details are missing."""\n'
            "PARAMETER temperature 0.15\n"
            "PARAMETER num_ctx 4096\n"
        )
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", prefix="xps-coder-", suffix=".Modelfile", delete=False) as handle:
            handle.write(model_file)
            path = handle.name
        try:
            result = subprocess.run(["ollama", "create", MODEL, "-f", path], text=True, capture_output=True)
        finally:
            os.unlink(path)
        if result.returncode:
            report("Could not create the local XPS model. " + (result.stderr.strip()[-500:] or "Check Ollama."))
            return False
        return True
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        report(f"Could not prepare the local coding model: {exc}")
        return False


def chat(messages):
    request_body = json.dumps({
        "model": MODEL,
        "messages": messages,
        "stream": False,
        "options": {"num_ctx": 4096, "temperature": 0.15},
    }).encode()
    request = urllib.request.Request(HOST + "/api/chat", request_body, {"Content-Type": "application/json"})
    with urllib.request.urlopen(request, timeout=300) as response:
        return json.load(response)["message"]["content"].strip()


class App:
    def __init__(self, root):
        self.root = root
        root.title("XPS Code Assistant · local")
        root.geometry("780x590")
        self.log = scrolledtext.ScrolledText(root, wrap="word", state="disabled", font=("Sans", 11))
        self.log.pack(fill="both", expand=True, padx=8, pady=(8, 4))

        mode_row = ttk.Frame(root)
        mode_row.pack(fill="x", padx=10, pady=(2, 6))
        ttk.Label(mode_row, text="Coding mode:").pack(side="left", padx=(0, 8))
        self.mode = tk.StringVar(value="Arduino / ESP32")
        self.mode_picker = ttk.Combobox(mode_row, textvariable=self.mode, values=list(MODES), state="readonly", width=24)
        self.mode_picker.pack(side="left")
        self.mode_picker.bind("<<ComboboxSelected>>", self.change_mode)
        self.status = ttk.Label(mode_row, text=f"Local model: {MODEL} · Ollama on this computer")
        self.status.pack(side="left", padx=12)

        row = ttk.Frame(root)
        row.pack(fill="x", padx=8, pady=(0, 8))
        self.entry = ttk.Entry(row, font=("Sans", 11))
        self.entry.pack(side="left", fill="x", expand=True)
        self.entry.bind("<Return>", lambda event: self.send())
        self.btn = ttk.Button(row, text="Send", command=self.send)
        self.btn.pack(side="left", padx=(6, 0))
        self.messages = [{"role": "system", "content": system_prompt(self.mode.get())}]
        self.busy = True
        self.say("Starting local coding assistant...\n")
        threading.Thread(target=self.boot, daemon=True).start()

    def say(self, text):
        self.log.configure(state="normal")
        self.log.insert("end", text)
        self.log.configure(state="disabled")
        self.log.see("end")

    def report(self, text):
        self.root.after(0, lambda text=text: self.say(text + "\n"))

    def change_mode(self, _event=None):
        selected = self.mode.get()
        self.messages = [{"role": "system", "content": system_prompt(selected)}]
        self.say(f"Mode changed to {selected}. Previous chat context was cleared.\n\n")

    def boot(self):
        if not start_server():
            self.report("Ollama could not start. Install Ollama, then reopen this app.")
            return
        self.report("Preparing the custom local coding model. First start may download around 1 GB...")
        if not ensure_custom_model(self.report):
            return
        self.busy = False
        self.root.after(0, lambda: (self.say("Ready. Choose Arduino/ESP32, Linux sysadmin, Raspberry Pi, code review, or build/debug. This model runs locally; no Codex or cloud API is used.\n\n"), self.entry.focus_set()))

    def send(self):
        text = self.entry.get().strip()
        if not text or self.busy:
            return
        self.entry.delete(0, "end")
        self.busy = True
        self.say(f"You: {text}\n")
        self.messages.append({"role": "user", "content": text})
        self.messages = self.messages[:1] + self.messages[1:][-12:]
        threading.Thread(target=self.ask, daemon=True).start()

    def ask(self):
        try:
            answer = chat(self.messages)
            self.messages.append({"role": "assistant", "content": answer})
            self.root.after(0, lambda answer=answer: self.say(f"XPS Code Assistant ({self.mode.get()}): {answer}\n\n"))
        except Exception as exc:
            message = str(exc)
            self.root.after(0, lambda message=message: self.say(f"(Request failed: {message})\n\n"))
        finally:
            self.busy = False


if __name__ == "__main__":
    app_root = tk.Tk()
    App(app_root)
    app_root.mainloop()
