#!/usr/bin/python3
"""Local security center: offers session locking and honest device-security checks."""
import subprocess
import tkinter as tk
from tkinter import ttk


def session_is_encrypted():
    try:
        result = subprocess.run(
            ["lsblk", "-no", "FSTYPE", "/"], check=False, capture_output=True, text=True, timeout=4
        )
        return "crypto_LUKS" in result.stdout or "crypt" in result.stdout
    except (OSError, subprocess.TimeoutExpired):
        return False


class SecurityCenter:
    def __init__(self, root):
        self.root = root
        root.title("XPS Security Center")
        root.geometry("620x420")
        root.minsize(520, 360)

        ttk.Label(root, text="Device security", font=("Sans", 18, "bold")).pack(anchor="w", padx=20, pady=(20, 8))
        ttk.Label(
            root,
            text=("This center provides real session locking and practical checks. It does not install fake per-app "
                  "password prompts or alter PAM. A prompt around an app can be bypassed and is not an access boundary."),
            wraplength=570, justify="left",
        ).pack(fill="x", padx=20, pady=8)

        self.encryption = ttk.Label(root, wraplength=570, justify="left")
        self.encryption.pack(fill="x", padx=20, pady=8)
        if session_is_encrypted():
            self.encryption.configure(text="Storage check: the root filesystem appears to use device encryption. Confirm your home/data volumes too.")
        else:
            self.encryption.configure(text="Storage check: could not confirm encryption for /. Check Omarchy's installation settings; full-disk encryption is strongest when enabled during installation.")

        ttk.Label(
            root,
            text=("Recommended: keep a strong account password, enable automatic idle locking in Omarchy settings, "
                  "and use encrypted storage for private source code and credentials. The AI assistant uses a local "
                  "Ollama endpoint; do not enter secrets you would not store in a local chat."),
            wraplength=570, justify="left",
        ).pack(fill="x", padx=20, pady=8)
        ttk.Button(root, text="Lock screen now", command=self.lock_screen).pack(anchor="e", padx=20, pady=14)

    def lock_screen(self):
        for command in (["omarchy-lock-screen"], ["loginctl", "lock-session"]):
            try:
                subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return
            except FileNotFoundError:
                continue
        self.encryption.configure(text="Could not find a supported screen-lock command. Use Omarchy's lock-screen shortcut/menu.")


if __name__ == "__main__":
    window = tk.Tk()
    SecurityCenter(window)
    window.mainloop()
