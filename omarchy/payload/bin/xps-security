#!/usr/bin/env bash
# xps-security: add a USB-storage presence check to Omarchy's lock PAM service.
# Keep the normal password as the primary factor and the recovery code as fallback.
#   xps-security enroll    set up (or change) the USB key and recovery code
#   xps-security status    show configured state
#   xps-security test      test the PAM service without locking the session
#   xps-security disable   restore the original lock PAM file
set -u
SRC=/usr/local/share/xps-security/src
CONF=${XPS_CONF:-/etc/xps-security/xps.conf}
PAM_DIR=${XPS_PAM_DIR:-/etc/pam.d}
MOD=${XPS_PAM_MODULE:-/usr/lib/security/pam_xps.so}

# Omarchy calls its lock-screen PAM service omarchy-lock-password. Older/custom
# Hyprlock setups may instead provide a dedicated hyprlock service. Only touch a
# PAM stack that already exists; never create a guessed service file.
if [ -f "$PAM_DIR/omarchy-lock-password" ]; then
    PAMFILE="$PAM_DIR/omarchy-lock-password"
elif [ -f "$PAM_DIR/hyprlock" ]; then
    PAMFILE="$PAM_DIR/hyprlock"
else
    PAMFILE=""
fi
if [ -n "$PAMFILE" ]; then
    PAM_SERVICE=${PAMFILE##*/}
    BACKUP="$PAMFILE.before-xps"
else
    PAM_SERVICE=""
    BACKUP=""
fi

say()  { printf '\n\033[1;36m==> %s\033[0m\n' "$*"; }
ok()   { printf '  \033[32m[ok]\033[0m %s\n' "$*"; }
die()  { printf '  \033[31m[stopped]\033[0m %s\n' "$*"; echo "  Nothing was switched on. Your lock screen is unchanged."; [ -t 0 ] && read -r -p "  Press Enter to close. " _; exit 1; }
rescue() {
    cat <<EOT

  IF YOU EVER CANNOT UNLOCK:
    1. Press Ctrl+Alt+F3 and log in with your normal password.
    2. Run: sudo cp "$BACKUP" "$PAMFILE"
    3. Press Ctrl+Alt+F1 (or F2) to return to the screen.
EOT
}
usb_sticks() {
    local p
    for p in /dev/disk/by-id/usb-*; do
        [ -e "$p" ] || continue
        case "$p" in *-part[0-9]*) continue;; esac
        basename "$p"
    done
}
conf_get() { sed -n "s/^$1=//p" "$CONF" 2>/dev/null | head -1; }

status() {
    local id; id=$(conf_get usb_id)
    if [ -z "$id" ]; then echo "Security: not set up"; return 1; fi
    echo "USB storage key: $id"
    grep -q '^face=1' "$CONF" 2>/dev/null && echo "Face check: on" || echo "Face check: off"
    [ -e "/dev/disk/by-id/$id" ] && echo "USB key plugged in: yes" || echo "USB key plugged in: no"
    if [ -n "$PAMFILE" ] && grep -q pam_xps "$PAMFILE" 2>/dev/null; then
        echo "Lock screen PAM service ($PAM_SERVICE) uses it: yes"
    else
        echo "Lock screen PAM service: not configured (run xps-security enroll)"
    fi
    systemctl --user is-active --quiet xps-usb-watch.service 2>/dev/null && echo "Locks when key is pulled: yes" || echo "Locks when key is pulled: no"
}

make_stack() { # $1 = extra module arguments
    # A fixed, simple stack (password, then the USB/recovery check). It does not copy Omarchy's own
    # file, because that file's exact layout varies and a guessed edit can make the password fail.
    printf '%s\n' "# written by xps-security; original saved as $BACKUP" \
        "auth       required     pam_unix.so" \
        "auth       required     pam_xps.so $1" \
        "account    required     pam_unix.so"
}

make_stack_pamusb() {
    # password first; then the stick is checked by pam_usb; if pam_usb does not accept it,
    # the recovery code is asked (pam_xps pointed at an empty folder always asks for the code).
    printf '%s\n' "# written by xps-security (pam_usb mode); original saved as $BACKUP" \
        "auth       required     pam_unix.so" \
        "auth       sufficient   pam_usb.so" \
        "auth       required     pam_xps.so usbdir=/var/empty" \
        "account    required     pam_unix.so"
}

setup_pamusb() {
    say "Installing pam_usb (the community USB login module)"
    if ! command -v pamusb-check >/dev/null 2>&1; then
        local helper=""; command -v yay >/dev/null 2>&1 && helper=yay; [ -z "$helper" ] && command -v paru >/dev/null 2>&1 && helper=paru
        [ -n "$helper" ] || die "I need the AUR helper (yay) that Omarchy normally includes, and it was not found."
        "$helper" -S --needed --noconfirm pam_usb || die "pam_usb did not install from the Arch user repository."
    fi
    command -v pamusb-conf >/dev/null 2>&1 || die "pam_usb installed but its setup tool (pamusb-conf) is missing."
    sudo systemctl enable --now udisks2.service >/dev/null 2>&1
    echo "  Teaching pam_usb about your stick. If it asks which volume, choose the one for your stick."
    local pc=/etc/security/pam_usb.conf
    # Safe to run again: skip what an earlier run already registered.
    if sudo grep -q 'device id="xps-key"' "$pc" 2>/dev/null; then ok "Your stick is already registered with pam_usb"
    else sudo pamusb-conf --add-device xps-key || die "pam_usb could not register the stick."; fi
    if sudo grep -q "user id=\"$USER\"" "$pc" 2>/dev/null; then ok "Your user is already registered with pam_usb"
    else sudo pamusb-conf --add-user "$USER" || die "pam_usb could not register your user."; fi
    pamusb-check "$USER" || die "pam_usb does not recognise the stick. Keep it plugged in. If you changed or reformatted it, run: sudo pamusb-conf --reset-pads=$USER"
    ok "pam_usb recognises your stick"
}

build() {
    B=$(mktemp -d)
    gcc -O2 -Wall -shared -fPIC -I"$SRC" -o "$B/pam_xps.so" "$SRC/pam_xps.c" "$SRC/xps_check.c" -lpam -lcrypt || return 1
    gcc -O2 -Wall -I"$SRC" -o "$B/xps-pamtest" "$SRC/xps_pamtest.c" -lpam || return 1
    gcc -O2 -Wall -I"$SRC" -o "$B/xps-codehash" "$SRC/xps_codehash.c" "$SRC/xps_check.c" -lcrypt || return 1
}

disable() {
    say "Switching the USB-key check off"
    [ -n "$PAMFILE" ] || die "No supported lock-screen PAM file exists (looked for omarchy-lock-password and hyprlock)."
    if [ -f "$BACKUP" ]; then sudo cp "$BACKUP" "$PAMFILE" && ok "Original $PAM_SERVICE PAM settings restored"; else echo "  (no XPS backup found; PAM file left unchanged)"; fi
    sudo rm -f "$PAM_DIR/xps-lock" "$PAM_DIR/xps-lock-test"
    systemctl --user disable --now xps-usb-watch.service xps-login-lock.service >/dev/null 2>&1
    ok "USB-key check is off. Password-based lock screen restored."
}

test_login() {
    say "Testing the lock-screen PAM service (this does not lock the session)"
    [ -n "$PAM_SERVICE" ] || die "No supported lock-screen PAM file exists."
    [ -x "${B:-}/xps-pamtest" ] || build || die "Could not build the test tool."
    echo "  PAM service: $PAM_SERVICE"
    echo "  Type your normal password (input will not be displayed):"
    "$B/xps-pamtest" "${1:-$PAM_SERVICE}" "$USER"
}

# Up to 3 tries, so one mistyped password or code does not end the setup.
try_test() {
    local n
    for n in 1 2 3; do
        "$B/xps-pamtest" "$1" "$USER" | tee /dev/stderr | grep -q "AUTH OK" && return 0
        [ "$n" -lt 3 ] && echo "  That did not work. Try again ($n of 3). The first prompt wants your Linux password (the one you type for sudo); a second prompt wants the recovery code."
    done
    return 1
}

enroll() {
    [ -n "$PAMFILE" ] || die "Could not find a supported lock-screen PAM file. Looked for $PAM_DIR/omarchy-lock-password and $PAM_DIR/hyprlock."
    [ -f "$SRC/pam_xps.c" ] && [ -f "$SRC/xps_check.c" ] || die "Security module source files are missing. Run the latest XPS Setup first."
    command -v gcc >/dev/null || die "The compiler is missing. Run the XPS Setup app first."
    sudo -v || die "Administrator permission is needed."

    say "Step 1 of 4: your USB storage key"
    local id=""
    while [ -z "$id" ]; do
        mapfile -t sticks < <(usb_sticks)
        if [ ${#sticks[@]} -eq 0 ]; then
            read -r -p "  Plug in the USB stick you want to use as your key, then press Enter. " _
            continue
        fi
        echo "  USB storage devices found:"
        local i=1 s size
        for s in "${sticks[@]}"; do
            size=$(lsblk -dno SIZE "$(readlink -f "/dev/disk/by-id/$s")" 2>/dev/null)
            echo "    $i) $s  ($size)"; i=$((i+1))
        done
        read -r -p "  Which number is your key? " n
        if [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le ${#sticks[@]} ]; then id=${sticks[$((n-1))]}; else echo "  Please type one of the numbers."; fi
    done
    ok "Key: $id"

    say "Step 2 of 4: your recovery code (used if the key is lost)"
    echo "  Choose 4 to 8 digits. Pick one you have NOT typed in any chat or shared. You will not see it as you type."
    local c1 c2
    while true; do
        read -r -s -p "  Recovery code: " c1; echo
        read -r -s -p "  Again: " c2; echo
        [[ "$c1" =~ ^[0-9]{4,8}$ ]] || { echo "  Use only digits, 4 to 8 of them."; continue; }
        [ "$c1" = "$c2" ] || { echo "  They did not match. Try again."; continue; }
        break
    done

    say "Step 3 of 4: building and testing (nothing is switched on yet)"
    build || die "Could not build the security module."
    local hash; hash=$("$B/xps-codehash" <<<"$c1")
    [ -n "$hash" ] || die "Could not scramble the code."
    unset c1 c2

    sudo install -d -m755 /etc/xps-security || die "Could not create the settings folder."
    printf 'usb_id=%s\ncode_hash=%s\n' "$id" "$hash" | sudo tee "$CONF.new" >/dev/null && sudo chmod 644 "$CONF.new" && sudo mv "$CONF.new" "$CONF" || die "Could not save the settings."
    sudo install -Dm644 "$B/pam_xps.so" "$MOD" || die "Could not install the security module."
    [ -f "$BACKUP" ] || sudo cp -a "$PAMFILE" "$BACKUP" || die "Could not back up the lock-screen settings."

    if [ "${XPS_MODE:-own}" = pamusb ]; then
        setup_pamusb
        make_stack_pamusb | sudo tee "$PAM_DIR/xps-lock" >/dev/null || die "Could not prepare the pam_usb lock layout."
    else
        make_stack "" | sudo tee "$PAM_DIR/xps-lock" >/dev/null || die "Could not prepare the lock layout."
    fi
    make_stack "usbdir=/var/empty" | sudo tee "$PAM_DIR/xps-lock-test" >/dev/null || die "Could not prepare the recovery test stack."

    echo
    echo "  Test A: key plugged in. At \"Password:\" type your Linux password (the same one you type for sudo)."
    try_test xps-lock || { sudo rm -f "$PAM_DIR/xps-lock" "$PAM_DIR/xps-lock-test"; die "Test A failed (password plus key)."; }
    ok "Password + key works"
    echo
    echo "  Test B: pretending the key is lost. Type your normal password, then your recovery code."
    try_test xps-lock-test || { sudo rm -f "$PAM_DIR/xps-lock" "$PAM_DIR/xps-lock-test"; die "Test B failed (password plus recovery code)."; }
    ok "Password + recovery code works"

    say "Step 4 of 4: switching on for $PAM_SERVICE"
    sudo cp "$PAM_DIR/xps-lock" "$PAMFILE" || die "Could not switch the lock screen over."
    sudo rm -f "$PAM_DIR/xps-lock-test"
    systemctl --user daemon-reload
    systemctl --user enable --now xps-usb-watch.service >/dev/null 2>&1 || die "Could not enable the USB removal watcher; restore with xps-security disable."
    systemctl --user restart xps-usb-watch.service >/dev/null 2>&1
    systemctl --user enable xps-login-lock.service >/dev/null 2>&1 && ok "After each automatic login the screen locks and asks for password + key."
    ok "USB check enabled for the existing $PAM_SERVICE PAM service. Password remains required."
    ok "Removing the enrolled USB storage device locks the session."
    rescue
}

face_on() {
    say "Adding the face check (only works with the built-in USB check, not pam_usb mode)"
    [ -f "$CONF" ] || die "Set up the USB key first (Security setup), then add the face check."
    grep -q pam_usb "$PAMFILE" 2>/dev/null && die "The face check works with the built-in USB check. Run Security setup (USB key) first to switch to it."
    command -v xps-face >/dev/null || die "xps-face is missing. Run the XPS Setup app again."
    xps-face status | grep -q "Models present: yes" || die "The face models are missing. Run the XPS Setup app again (it downloads them)."
    echo "  Step 1: your face. Sit in normal light, look at the camera."
    read -r -p "  Press Enter to start. " _
    xps-face enroll || die "Could not save your face."
    echo "  Step 2: test. Keep looking at the camera."
    xps-face verify && ok "The camera recognises you" || die "The camera did not recognise you. Try again in better light."
    sudo sed -i '/^face=/d' "$CONF" && echo "face=1" | sudo tee -a "$CONF" >/dev/null || die "Could not save the setting."
    ok "Face check is on: with the key plugged in, your face must also match. Without a match, the recovery code is asked."
    echo "  Turn it off any time: xps-security face-off"
}
face_off() {
    sudo sed -i '/^face=/d' "$CONF" 2>/dev/null
    ok "Face check is off (the USB key and password still work)."
}

case "${1:-}" in
    face-on)  face_on ;;
    face-off) face_off ;;
    enroll)  enroll ;;
    enroll-pamusb) XPS_MODE=pamusb; enroll ;;
    status)  status ;;
    test)    test_login "${2:-}" ;;
    disable) disable ;;
    *) echo "usage: xps-security enroll | enroll-pamusb | face-on | face-off | status | test [pam-service] | disable"; exit 1 ;;
esac
[ "${1:-}" = enroll ] || [ "${1:-}" = enroll-pamusb ] || [ "${1:-}" = face-on ] || [ "${1:-}" = disable ] && { [ -t 0 ] && read -r -p "Press Enter to close. " _; }
exit 0
