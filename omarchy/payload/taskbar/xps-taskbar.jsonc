{
  "name": "xps-taskbar",
  "layer": "top",
  "position": "bottom",
  "height": 38,
  "spacing": 6,
  "modules-left": ["custom/apps", "custom/update"],
  "modules-center": ["wlr/taskbar"],
  "modules-right": ["custom/panel", "clock"],
  "custom/apps": {
    "format": "  Apps  ",
    "tooltip": false,
    "on-click": "xps-apps"
  },
  "custom/update": {
    "format": "  Update  ",
    "tooltip": false,
    "on-click": "xps-update"
  },
  "wlr/taskbar": {
    "format": "{icon} {title:.22}",
    "icon-size": 20,
    "all-outputs": true,
    "tooltip-format": "{title}\nClick: minimize/restore   Middle-click: close   Right-click: activate",
    "on-click": "minimize-raise",
    "on-click-middle": "close",
    "on-click-right": "activate"
  },
  "custom/panel": {
    "format": " Panel ",
    "tooltip": false,
    "on-click": "xps-panel"
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  }
}
