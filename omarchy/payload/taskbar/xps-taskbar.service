[Unit]
Description=XPS taskbar (bottom bar listing open windows)
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=0

[Service]
ExecStartPre=/bin/sleep 2
ExecStart=/usr/bin/waybar -c %h/.config/waybar/xps-taskbar.jsonc -s %h/.config/waybar/xps-taskbar.css
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
